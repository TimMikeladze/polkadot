{
	"name": "placeholder-images",
	"version": "0.1.0",
	"description": "Deterministic generative placeholder images — SVG, PNG, and an HTTP endpoint, from a seed string",
	"keywords": [
		"avatar",
		"cover-art",
		"deterministic",
		"generative",
		"identicon",
		"placeholder",
		"png",
		"svg"
	],
	"homepage": "https://github.com/TimMikeladze/placeholder-images#readme",
	"bugs": {
		"url": "https://github.com/TimMikeladze/placeholder-images/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TimMikeladze/placeholder-images.git"
	},
	"bin": {
		"placeholder-images": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./server": {
			"import": {
				"types": "./dist/server.d.ts",
				"default": "./dist/server.js"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bunup",
		"dev": "bunup --watch",
		"format": "oxfmt",
		"lint": "oxlint",
		"prepare": "bun simple-git-hooks",
		"serve": "bun run src/cli.ts",
		"release": "bumpp --commit --push --tag",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"test:watch": "bun test --watch",
		"type-check": "tsc --noEmit"
	},
	"devDependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"@types/bun": "^1.3.14",
		"bumpp": "^12.2.0",
		"bunup": "^0.16.32",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"@resvg/resvg-js": ">=2.0.0",
		"typescript": ">=4.5.0"
	},
	"peerDependenciesMeta": {
		"@resvg/resvg-js": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	},
	"simple-git-hooks": {
		"pre-commit": "bun run lint && bun run type-check"
	}
}
